<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.sems.sems.Mapper.XmcgbqkMapper">
    <!-- 动态插入 -->
    <insert id="insertXmcgbqkDynamic" parameterType="org.sems.sems.entity.Xmcgbqk">
        INSERT INTO xmcgbqk
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="bqnr != null">BQNR,</if>
            <if test="xmdm != null">XMDM,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="bqnr != null">#{bqnr},</if>
            <if test="xmdm != null">#{xmdm},</if>
        </trim>
    </insert>

    <!-- 动态更新 -->
    <update id="updateXmcgbqkDynamic" parameterType="org.sems.sems.entity.Xmcgbqk">
        UPDATE xmcgbqk
        <set>
            <if test="bqnr != null">BQNR = #{bqnr},</if>
            <if test="xmdm != null">XMDM = #{xmdm},</if>
        </set>
        WHERE ID = #{id}
    </update>

    <!-- 动态删除 -->
    <delete id="deleteXmcgbqkById" parameterType="org.sems.sems.entity.Xmcgbqk">
        DELETE FROM xmcgbqk WHERE ID = #{id}
    </delete>
</mapper>

